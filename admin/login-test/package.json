{
  "name": "library-login-test",
  "private": true,
  "description": "Echter Login-Test: die Library im Browser gegen die Firebase-Emulatoren (Anmeldung + Datenbank mit den echten firestore.rules). Siehe login-test.js",
  "scripts": {
    "test": "firebase emulators:exec --config ../../firebase.json --only auth,firestore --project demo-library \"node login-test.js\"",
    "features": "firebase emulators:exec --config ../../firebase.json --only auth,firestore --project demo-library \"node features-test.js\"",
    "last": "firebase emulators:exec --config ../../firebase.json --only auth,firestore --project demo-library \"node last-test.js\""
  },
  "devDependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.48.0"
  }
}
