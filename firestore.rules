rules_version = '2';

// Helfenberger's Library — Firestore Security Rules
//
// Data model (Storage-free: uploaded exercise pages live directly in Firestore,
// so the whole project can run on the free "Spark" plan with no credit card):
//   students/{uid}                        -> {username, displayName, role}   (written only by the admin script, read-only for clients)
//   resources/{resourceId}                          -> {subject, title, fileName, uploadedAt, uploadedBy}  (lightweight metadata, listed per subject)
//   resourceContent/{resourceId}                    -> {chunkCount}                                        (fetched only when a resource is opened)
//   resourceContent/{resourceId}/chunks/{chunkId}    -> {html} or {bin: bytes, PDFs}   (<=~900KB each; a large upload is split into several of these and
//                                                                 rejoined on read — see chunkStringByBytes() in index.html)
//   progress/{uid}/resources/{resourceId}           -> {stats, total, updatedAt}                           (each student's own practice progress)
//   folders/{folderId}                              -> {subject, parentId, name, order, createdAt, createdBy} (per-subject folder tree)
//   calendarEntries/{entryId}                       -> {type, subject, title, description, dueDate, createdAt, createdBy} (Hausaufgaben/Abgaben/Prüfungen/Erinnerungen)
//   pushSubscriptions/{uid}/devices/{subId}          -> each signed-in user's own push-notification device registrations
//   debts/{uid}                                     -> {entries:[{id, amount, what, createdAt}], updatedAt} (kleine Schulden
//                                                       bei der Lehrperson; nur die betroffene Person und die Lehrperson lesen)
//   teacherTodos/{todoId}                           -> {text, description, subject, dueDate, done, doneAt, createdAt, createdBy} (private
//                                                       To-do-Liste der Lehrperson im Lehrerbereich; nie für Schüler:innen sichtbar)
//   appMeta/{id}                                    -> one-off seed markers (e.g. "was the Rotstift link
//                                                       resource already created?"), so the app can create a
//                                                       default entry exactly once without resurrecting it
//                                                       after the teacher deletes it
//   pruefungKorrektur/{pruefungId}                            -> {titel, fach, klasse, aufgaben, erstelltAm} (teacher-only exam
//                                                                 correction tool, "Rotstift" — separate from the resources/
//                                                                 progress system, never shown to students)
//   pruefungKorrektur/{pruefungId}/schueler/{schuelerId}      -> {name, pageCount, ergebnisse, gesamtpunkte, maxPunkte, korrigiertAm}
//   pruefungKorrekturScans/{schuelerId}/pages/{pageIndex}     -> {b64, mime, bytes} (downscaled JPEG per scanned page,
//                                                                 base64 in Firestore since there is no Firebase Storage)
//
//   klasseninfo/aemtli                              -> {startDate, weekdays, zeiten, aemtli:[{icon,name,offset}],
//                                                       teams:[[uid,uid],...], skipWeeks:[...]}  Aemtliplan. Liegt bewusst
//                                                       NICHT unter klassenzimmer/: die Klasse muss ihn lesen koennen.
//   klassenzimmer/gruppen                           -> {rollen:[...]} Rollen des Gruppengenerators (teacher-only)
//   progress/{uid}/erledigt/liste                   -> {ids:{entryId:true}, updatedAt}  was die Schueler:in fuer SICH
//                                                       abgehakt hat; unabhaengig von submitted.{uid} der Lehrperson
//   progress/{uid}/eigeneEintraege/{id}             -> selbst eingetragene Kalendereintraege (gleiche Felder wie
//                                                       calendarEntries), nur fuer die Person selbst sichtbar
//   progress/{uid}/einstellungen/layout            -> {ordnung:{kacheln,leiste}, aus:[...]} Anordnung (nur die Person selbst)
//   progress/{uid}/einstellungen/stundenplan       -> LP: eigener Plan {zeiten, zellen}; SuS: eigene Abweichungen {zellen}
//   klassen/{k}/klasseninfo/stundenplan            -> Klassenplan {zeiten, zellen} (Klasse liest, LP schreibt)
//   progress/{uid}/noten/liste                      -> {faecher:{fachId:[{id,name,note,gewicht}]}, updatedAt}
//                                                       privater Notenrechner, nur die Person selbst
//   progress/{uid}/pruefungsnoten/{klasse}_{pruefId} -> {fach, name, note, gewicht, pruefungId, klasse, datum}
//                                                       Note aus einer Online-Prüfung; schreibt nur die Lehrperson
//                                                       (beim Freigeben der Resultate), die Person liest sie im Notenrechner
//   quizSessions/umfrage                            -> laufende Blitzumfrage (nutzt die bestehenden quizSessions-Regeln,
//                                                       Stimmen liegen unter .../antworten/{uid})
//   klassenzimmer/sitzplan                          -> aktueller Sitzplan {tables, seats, meta, rules, absent,
//                                                       genderMode, mirror, teilen}; tables[].kind = tisch | pult | block;
//                                                       teilen = {gastUid: uid} Fach-Gast teilt den Platz dieser Person
//   klassenzimmer/sitzplaene                        -> {plans:[{id, name, savedAt, tables, seats}]} gespeicherte
//                                                       Sitzordnungen zum Wiederladen
//   fragen/{fragenId}                               -> {text, subject, name, answer, published, createdAt} (Fragebox:
//                                                       name ist leer, wenn anonym gefragt wurde - dann steht im
//                                                       Dokument nichts über die Person, auch keine uid; nur die
//                                                       Lehrperson liest ungefilterte Fragen, veröffentlichte
//                                                       Antworten sieht die ganze Klasse)
//   streaks/{uid}                                   -> {days:{'YYYY-MM-DD': Sekunden}, goalMin} (Lern-Serie)
//   quizzes/{quizId}                                -> {title, subject, questions:[{q,a,c,sec}], createdAt} (NUR Lehrperson
//                                                       lesbar - hier stehen die richtigen Antworten drin)
//   quizSessions/aktiv                              -> laufende Quiz-Runde (feste Dokument-ID, es läuft immer nur eine)
//   quizSessions/aktiv/antworten/{uid}              -> {qIndex, choice, at, name}   (jede:r schreibt nur die eigene)
//   quizSessions/aktiv/spieler/{uid}                -> {name, score, correct}       (Punkte setzt nur die Lehrperson)
//   pruefungen/{id}                                 -> {titel, art: nativ|bank, resourceId, contentId, cfg, seed, fragen (OHNE
//                                                       Lösungen), bilder, status: entwurf|offen|beendet, resultateFrei,
//                                                       punkteFuer6, rundung, fach, gewicht} Online-Prüfung (Prüfungsmodus)
//   pruefungen/{id}/intern/loesung                  -> {loesungen:{frageId:{typ, loesung, anzeige, punkte}}} NUR Lehrperson
//   pruefungen/{id}/teilnahmen/{uid}                -> {status: laeuft|gesperrt|abgegeben, aktiv, antworten, verstoesse,
//                                                       punkte, max, details}. Die Person schreibt nur, solange
//                                                       status == 'laeuft' — entsperren kann nur die Lehrperson.
//
// KLASSEN (seit Herbst 2026): Alles Klassenbezogene liegt unter
//   klassen/{klasse}/{resources|folders|calendarEntries|debts|appMeta|klassenzimmer|
//                     klasseninfo|fragen|quizzes|quizSessions}/...
// mit denselben Feldern wie oben beschrieben. resourceContent bleibt global
// (resources.contentId zeigt darauf, Kopien in mehreren Klassen teilen ihn).
//   lehrer/{uid}/todos/{todoId}                     -> private To-dos jeder Lehrperson
//   students/{uid}.klasse                           -> Klasse der Person
//   gruppen/{id}                                    -> {ownerUid, ownerName, ownerKlasse, fach, name, mitglieder:[uid],
//                                                       namen:{uid:{n,nn,u,k}}} 👥 Gruppen (siehe index.html)
//   klassen/{k}/calendarEntries/{id}.gruppeId/.mitglieder -> Eintrag nur für diese Gruppe
//   loginAliases/{slug}                             -> {konten:[username]} Vorname/Kürzel -> Konten
//   Seiten ohne Klasse: klassen/flp-<name>, isf-<name>, praktikum-<n> (FLP, ISF, Praktikum)
//   students/{uid}.nurFach                          -> optional, z.B. 'mathe': Fach-Gast aus einer anderen
//                                                       Klasse, nur in diesem Fach dabei (siehe index.html)
//
// Schulleitung (schulleitung) trägt `leitung: true` und `klasse`: nur Lesen, siehe isLeitung().
// Lehrpersonen (helfenberger, schlaepfer, schoch) tragen die Custom Claims
// `teacher: true` und `klasse`, Schüler:innen nur `klasse` — gesetzt von
// admin/klassen-accounts.js. Schüler:innen lesen nur ihre eigene Klasse,
// Lehrpersonen alle.
//
// Die klassenlosen Collections weiter unten (resources, folders, calendarEntries,
// ...) sind der Stand VOR der Umstellung und werden danach gesperrt
// (siehe Abschnitt "ALT").

function isSignedIn() {
  return request.auth != null;
}

function isTeacher() {
  return isSignedIn() && request.auth.token.teacher == true;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

function inKlasse(klasse) {
  return isSignedIn() && (isTeacher() || request.auth.token.klasse == klasse);
}

// Schulleitung: Custom Claim `leitung: true` (admin/klassen-accounts.js).
// Darf ALLES LESEN, was eine Lehrperson lesen darf, aber nirgends schreiben
// ausser in den eigenen Pfaden (isOwner). Darum steht isLeitung() nur in
// read-Regeln; inKlasse() bleibt unverändert, weil es auch in create-Regeln
// (Fragebox, Quiz-Antworten) vorkommt.
function isLeitung() {
  return isSignedIn() && request.auth.token.leitung == true;
}

function canReadAll() {
  return isTeacher() || isLeitung();
}

function inKlasseLesen(klasse) {
  return inKlasse(klasse) || isLeitung();
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== KLASSEN =====================
    match /klassen/{klasse} {

      // Übungslisten sind für alle Angemeldeten lesbar (seit 19.09.2026):
      // Mitglieder einer 👥 Gruppe sehen die Übungen der Seite ihrer Lehrperson,
      // auch wenn sie in einer anderen Klasse sind. Die Inhalte selbst
      // (resourceContent) waren schon immer für alle Angemeldeten lesbar.
      match /resources/{resourceId} {
        allow read: if isSignedIn();
        allow create, update: if isTeacher();
        allow delete: if isTeacher();
      }

      match /folders/{folderId} {
        allow read: if isSignedIn();
        allow create, update: if isTeacher();
        allow delete: if isTeacher();
      }

      // Gruppen-Einträge tragen eine Kopie der Mitglieder (mitglieder:[uid]);
      // Mitglieder aus anderen Klassen lesen sie mit
      // where('mitglieder','array-contains', uid).
      match /calendarEntries/{entryId} {
        allow read: if inKlasseLesen(klasse)
          || (isSignedIn() && request.auth.uid in resource.data.get('mitglieder', []));
        allow create, update: if isTeacher();
        allow delete: if isTeacher();
      }

      match /debts/{uid} {
        allow read: if canReadAll() || (isOwner(uid) && inKlasse(klasse));
        allow create, update: if isTeacher()
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 100;
        // Separat von create/update: bei einem delete ist request.resource null.
        allow delete: if isTeacher();
      }

      // Keine Datenvalidierung, write darf kombiniert bleiben.
      match /appMeta/{id} {
        allow read: if inKlasseLesen(klasse);
        allow write: if isTeacher();
      }

      match /klassenzimmer/{toolId} {
        allow read: if canReadAll();
        allow write: if isTeacher();
      }

      match /klasseninfo/{toolId} {
        allow read: if inKlasseLesen(klasse);
        allow write: if isTeacher();
      }

      match /fragen/{fragenId} {
        allow read: if canReadAll() || (inKlasse(klasse) && resource.data.published == true);
        allow create: if inKlasse(klasse)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 600
          && request.resource.data.published == false
          && request.resource.data.answer == '';
        allow update: if isTeacher();
        allow delete: if isTeacher();
      }

      match /quizzes/{quizId} {
        allow read: if canReadAll();
        allow write: if isTeacher();
      }

      match /quizSessions/{sessionId} {
        allow read: if inKlasseLesen(klasse);
        allow create, update: if isTeacher();
        allow delete: if isTeacher();

        match /antworten/{uid} {
          allow read: if (isOwner(uid) && inKlasse(klasse)) || canReadAll();
          allow create, update: if isOwner(uid) && inKlasse(klasse);
          allow delete: if isTeacher();
        }

        match /spieler/{uid} {
          allow read: if inKlasseLesen(klasse);
          allow create: if isTeacher() || (isOwner(uid) && inKlasse(klasse) && request.resource.data.score == 0);
          allow update: if isTeacher() || (isOwner(uid) && inKlasse(klasse) && request.resource.data.score == resource.data.score);
          allow delete: if isTeacher();
        }
      }

      // Prüfungsmodus: die Klasse liest die Prüfung (Einstellungen, Status),
      // nur die Lehrperson legt an / ändert / löscht.
      match /pruefungen/{pruefungId} {
        allow read: if inKlasseLesen(klasse);
        allow create, update: if isTeacher();
        allow delete: if isTeacher();

        // Eigene Teilnahme: anlegen nur bei offener Prüfung und nur als
        // 'laeuft'; ändern nur, solange sie noch 'laeuft' (also nicht selbst
        // entsperren und nach der Abgabe nichts mehr ändern).
        match /teilnahmen/{uid} {
          allow read: if (isOwner(uid) && inKlasse(klasse)) || canReadAll();
          allow create: if isOwner(uid) && inKlasse(klasse)
            && request.resource.data.status == 'laeuft'
            && get(/databases/$(database)/documents/klassen/$(klasse)/pruefungen/$(pruefungId)).data.status == 'offen';
          allow update: if isTeacher() || (isOwner(uid) && inKlasse(klasse)
            && resource.data.status == 'laeuft'
            && request.resource.data.status in ['laeuft', 'gesperrt', 'abgegeben']);
          // Separat, siehe oben: bei einem delete ist request.resource null.
          allow delete: if isTeacher();
        }

        // Lösungen der Bank-Prüfungen: nie für Schüler:innen lesbar.
        // Keine Datenvalidierung, write darf kombiniert bleiben.
        match /intern/{docId} {
          allow read: if canReadAll();
          allow write: if isTeacher();
        }
      }
    }

    // 👥 Gruppen (pro Lehrperson und Fach, Schüler:innen aus beliebigen Klassen).
    // Lehrpersonen lesen alle, Schüler:innen nur die eigenen (array-contains).
    // Ändern/Löschen nur die Lehrperson, der die Gruppe gehört.
    match /gruppen/{gruppeId} {
      allow read: if canReadAll() || (isSignedIn() && request.auth.uid in resource.data.mitglieder);
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mitglieder is list
        && request.resource.data.mitglieder.size() <= 400;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.mitglieder is list
        && request.resource.data.mitglieder.size() <= 400;
      // Separat: bei einem delete ist request.resource null.
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    // Login mit Vorname oder Schul-Kürzel: loginAliases/{slug} = {konten:[...]}.
    // Vor der Anmeldung einzeln lesbar (get), aber nicht auflistbar; schreibt
    // nur das Admin-Skript.
    match /loginAliases/{slug} {
      allow get: if true;
      allow list, write: if false;
    }

    // Private To-dos jeder Lehrperson. Keine Datenvalidierung, darum kombiniert.
    match /lehrer/{uid}/todos/{todoId} {
      allow read: if canReadAll() && isOwner(uid);
      allow write: if isTeacher() && isOwner(uid);
    }

    // Roster info. Only the admin script (Admin SDK, bypasses rules) writes this.
    // Schüler:innen lesen nur die eigene Klasse (Abfrage where('klasse','==',...)).
    match /students/{uid} {
      allow read: if canReadAll() || isOwner(uid)
        || (isSignedIn() && resource.data.klasse == request.auth.token.klasse);
      allow write: if false;
    }

    // The actual content of each exercise page (kept separate from
    // resources/{resourceId} so browsing a subject's list doesn't have to
    // download every exercise's full content — only opening one does).
    // Split into chunk sub-documents so a page can exceed Firestore's ~1MiB
    // per-document limit (e.g. once exercises start including images).
    match /resourceContent/{resourceId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacher()
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 20;
      // Separate from create/update: on delete, request.resource is null, so a
      // combined rule that reads request.resource.data would always deny it.
      allow delete: if isTeacher();

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        // HTML-Übungen: {html: string}; PDFs: {bin: bytes} (rohe Bytes, kein Base64)
        allow create, update: if isTeacher()
          && ((request.resource.data.html is string
               && request.resource.data.html.size() < 950000) // ~950KB, under Firestore's 1MiB document cap
           || (request.resource.data.bin is bytes
               && request.resource.data.bin.size() < 950000));
        allow delete: if isTeacher();
      }
    }

    // Each student's own progress, one doc per resource. Teacher can read (not write) for an overview.
    match /progress/{uid}/resources/{resourceId} {
      allow read: if isOwner(uid) || canReadAll();
      allow write: if isOwner(uid);
    }

    // Die selbst abgehakten Kalendereintraege (Hausaufgaben/Abgaben/Unterschriften).
    // Rein zur eigenen Uebersicht der Schueler:in - die Abgabe-Checkliste der
    // Lehrperson steht unabhaengig davon auf dem Kalendereintrag selbst
    // (submitted.{uid}) und wird hier nicht beruehrt. Nur die eigene Person
    // schreibt. Keine Datenvalidierung angehaengt, darum kann write kombiniert
    // bleiben (bei einem delete waere request.resource null).
    match /progress/{uid}/erledigt/{docId} {
      allow read: if isOwner(uid) || canReadAll();
      allow write: if isOwner(uid);
    }

    // Eigene Kalendereintraege der Schueler:in (selbst eingetragene
    // Hausaufgaben etc.). Nur die Person selbst sieht und schreibt sie - auch
    // die Lehrperson nicht. Keine Datenvalidierung, darum kann write
    // kombiniert bleiben (bei einem delete waere request.resource null).
    match /progress/{uid}/eigeneEintraege/{entryId} {
      allow read, write: if isOwner(uid);
    }

    // Persönliche Einstellungen: Anordnung/ausgeblendete Kacheln und Symbole
    // (einstellungen/layout) und der eigene Stundenplan (einstellungen/stundenplan).
    // Nur die Person selbst; keine Datenvalidierung, darum kombiniert.
    match /progress/{uid}/einstellungen/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Privater Notenrechner (progress/{uid}/noten/liste). Nur die Person
    // selbst. Keine Datenvalidierung, write darf kombiniert bleiben.
    match /progress/{uid}/noten/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Noten aus Online-Prüfungen: nur die Lehrperson trägt ein/entfernt, die
    // Person selbst liest sie (Notenrechner).
    match /progress/{uid}/pruefungsnoten/{notenId} {
      allow read: if isOwner(uid) || canReadAll();
      allow create, update: if isTeacher()
        && request.resource.data.note is number
        && request.resource.data.note >= 1 && request.resource.data.note <= 6
        && request.resource.data.gewicht is number
        && request.resource.data.gewicht > 0 && request.resource.data.gewicht <= 10;
      // Separat: bei einem delete ist request.resource null.
      allow delete: if isTeacher();
    }

    // Each signed-in user's own push-notification device registrations.
    match /pushSubscriptions/{uid}/devices/{subId} {
      allow read, write: if isOwner(uid);
    }

    // Rotstift: exam correction tool. Teacher-only end to end — this holds
    // exam scores, so unlike resources/folders it is never student-readable.
    match /pruefungKorrektur/{pruefungId} {
      allow read: if canReadAll();
      allow write: if isTeacher();
      match /schueler/{schuelerId} {
        allow read: if canReadAll();
        allow write: if isTeacher();
      }
    }

    // Lern-Serie: geübte Minuten pro Tag. Jede:r schreibt nur die eigene,
    // die Lehrperson darf sie lesen (Überblick, wer regelmässig übt).
    match /streaks/{uid} {
      allow read: if isOwner(uid) || canReadAll();
      allow create, update: if isOwner(uid);
      // Separat, siehe oben.
      allow delete: if isTeacher();
    }

    match /pruefungKorrekturScans/{schuelerId} {
      allow read: if canReadAll();
      allow write: if isTeacher();
      match /pages/{pageIndex} {
        allow read: if canReadAll();
        allow write: if isTeacher();
      }
    }

    // ===================== ALT =====================
    // Klassenlose Collections von vor der Umstellung (Herbst 2026). Die Daten
    // liegen als Sicherung noch da, sind aber für die App gesperrt; nur das
    // Admin-SDK kommt noch dran.
    match /resources/{docId=**} {
      allow read, write: if false;
    }
    match /folders/{docId=**} {
      allow read, write: if false;
    }
    match /calendarEntries/{docId=**} {
      allow read, write: if false;
    }
    match /debts/{docId=**} {
      allow read, write: if false;
    }
    match /teacherTodos/{docId=**} {
      allow read, write: if false;
    }
    match /appMeta/{docId=**} {
      allow read, write: if false;
    }
    match /klassenzimmer/{docId=**} {
      allow read, write: if false;
    }
    match /klasseninfo/{docId=**} {
      allow read, write: if false;
    }
    match /fragen/{docId=**} {
      allow read, write: if false;
    }
    match /quizzes/{docId=**} {
      allow read, write: if false;
    }
    match /quizSessions/{docId=**} {
      allow read, write: if false;
    }
  }
}
